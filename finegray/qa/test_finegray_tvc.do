**# T24 the piecewise likelihood is the nested model's, summed correctly
local ++test_count
capture noisily {
    * Two invariants that need no external tool and that a wrongly-summed set of
    * per-interval passes cannot satisfy at once:
    *
    *  (a) at beta = 0 the linear predictor is 0 in every interval, so the NULL
    *      log-likelihood must equal the proportional fit's -- the J passes
    *      partition the cause events, and a pass that double-counted or dropped
    *      a time would move it.
    *  (b) the proportional model is nested inside the piecewise one, so the
    *      maximized log-likelihood must be strictly HIGHER.  A build that
    *      returned the proportional fit under a wider stripe would tie instead.
    _fgtv_data
    quietly finegray x1 x2, compete(status) cause(1) nolog
    local _p_ll0 = e(ll_0)
    local _p_ll  = e(ll)
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.4 1.0) nolog
    assert !missing(e(ll_0), `_p_ll0')
    * Not bit-identical: the J passes accumulate the same terms in a different
    * floating-point order.  Measured 1.1e-12 relative on this fixture.
    assert reldif(e(ll_0), `_p_ll0') < 1e-11
    assert !missing(e(ll), `_p_ll')
    assert e(ll) > `_p_ll'
    * df_m is the piecewise width, not the design width
    assert e(df_m) == colsof(e(b))
}
