*! test_finegray_tvc Version 1.0.0  2026/08/24
*! Regression tests for tvc()/tsplit(): piecewise-constant time-varying effects
*! Author: Timothy P Copeland, Karolinska Institutet

* WHY THIS SUITE EXISTS.
*
* tvc(varlist) with tsplit(numlist) lets the coefficient on the named covariates
* differ across intervals of analysis time.  The estimator is Fine & Gray (1999)
* with a deterministic Z(t) -- their sec. 2 (pp. 497-498) admits exactly that,
* and their own analysis (sec. 7, p. 503) fits treatment x t terms -- so what is
* new here is the computation, not the model.  That is also where it can go
* wrong quietly, in three ways, and every test below exists for one of them:
*
*  1. THE PIECEWISE SCAN IS NOT ACTUALLY PIECEWISE.  Running the ordinary scan
*     and merely widening the coefficient vector converges, posts plausible
*     numbers, and is a different estimator.  T01/T02 pin the fit against two
*     INDEPENDENT implementations of the same model: stcrreg's own tvc()/texp()
*     with an indicator time function (J = 2, the only shape one texp() can
*     express), and -- on data with no competing events, where the
*     subdistribution risk set IS the ordinary risk set -- a hand-split
*     episode Cox fit with ibn.interval#c.x terms, which reaches any J.  Both
*     agree on the log-likelihood as well as the coefficients, so a scan that
*     accumulated the right score from the wrong risk sets would still fail.
*
*  2. THE ORDINARY PATH MOVES.  The four right-censoring scans are called
*     UNMODIFIED, once per interval; nothing in them was edited.  T03 is the
*     guard that this stays true: a fit with no tvc() must reproduce values
*     captured from the tree before the feature existed, bit for bit.
*
*  3. THE TIE CONVENTION SILENTLY FLIPS.  Intervals are (cut_j-1, cut_j], so an
*     event exactly ON a boundary belongs to the EARLIER interval.  Every
*     baseline lookup downstream depends on that -- it is what lets the CIF use
*     an ordinary "largest event time <= s" search instead of a left limit.  T04
*     places an event exactly on a boundary and pins the direction, against
*     stcrreg with texp(_t > c) (agrees) and texp(_t >= c) (must not).
*
* Everything else is contract: the coefficient stripe (T05), e() (T06), the
* refit line the bootstrap replays (T07), determinism (T08), the CIF's own
* piecewise accumulation checked by hand against e(basehaz) (T09), the
* time-dependent xb (T10), factor variables (T11), the cost SHAPE rather than
* wall-clock seconds (T12), and every refusal (T13-T20).  The refusals are
* tested because each one keeps an unsourced or underived quantity from being
* reported at rc 0; a fence nobody tests is a fence that rots.

clear all
set varabbrev off
version 16.0

capture log close _all
log using "test_finegray_tvc.log", replace text name(_fgtv)

local qa_dir "`c(pwd)'"
local pkg_dir = regexr("`qa_dir'", "/qa$", "")
capture ado uninstall finegray
quietly net install finegray, from("`pkg_dir'") replace

local test_count = 0
local pass_count = 0
local fail_count = 0

capture program drop _fgtv_result
program define _fgtv_result, rclass
    args rc label
    if `rc' == 0 {
        display as result "  PASS: `label'"
        return scalar pass = 1
        return scalar fail = 0
    }
    else {
        display as error "  FAIL: `label' (rc=`rc')"
        return scalar pass = 0
        return scalar fail = 1
    }
end

* Competing-risks fixture with a genuinely piecewise cause-1 effect: the
* cause-specific hazard of x1 is 0.8 before `tau' and 0 after, generated by
* two-piece inversion so the change point is exact rather than approximate.
* The SUBDISTRIBUTION effect is not equal to that number -- the two hazards are
* different functionals -- so nothing below asserts recovery of 0.8; what the
* fixture buys is a fit in which the interval coefficients genuinely differ.
capture program drop _fgtv_data
program define _fgtv_data
    version 16.0
    args seed nobs
    if "`seed'" == "" local seed 20260824
    if "`nobs'" == "" local nobs 900
    clear
    set seed `seed'
    quietly set obs `nobs'
    gen long id = _n
    gen byte grp = 1 + mod(_n, 3)
    gen double x1 = rnormal()
    gen double x2 = rbinomial(1, 0.4)
    local tau = 0.7
    gen double h1a = 0.6 * exp(0.80 * x1 - 0.50 * x2)
    gen double h1b = 0.6 * exp(0.00 * x1 - 0.50 * x2)
    gen double E   = -ln(runiform())
    gen double tt1 = cond(E <= h1a * `tau', E / h1a, `tau' + (E - h1a * `tau') / h1b)
    gen double tt2 = -ln(runiform()) / (0.35 * exp(0.30 * x1))
    gen double tc  = rexponential(2.0)
    gen double t   = min(tt1, tt2, tc)
    gen byte status = cond(t == tt1, 1, cond(t == tt2, 2, 0))
    gen byte anyev = status != 0
    quietly stset t, failure(anyev == 1) id(id)
end

* Same generator with the competing cause switched off.  With no competing
* events no subject is ever retained in a risk set past its own exit, so the
* subdistribution risk set is the ordinary one and the estimator collapses to
* Cox -- which is what makes the split-episode oracle in T02 legitimate.
capture program drop _fgtv_data_nc
program define _fgtv_data_nc
    version 16.0
    args seed nobs
    if "`seed'" == "" local seed 987654
    if "`nobs'" == "" local nobs 1200
    clear
    set seed `seed'
    quietly set obs `nobs'
    gen long id = _n
    gen double x1 = rnormal()
    gen double x2 = rbinomial(1, 0.4)
    gen double tt1 = -ln(runiform()) / (0.70 * exp(0.60 * x1 - 0.40 * x2))
    gen double tc  = rexponential(1.6)
    gen double t   = min(tt1, tc)
    gen byte status = cond(t == tt1, 1, 0)
    gen byte anyev = status != 0
    quietly stset t, failure(anyev == 1) id(id)
end

* Build the (start, stop] episode split by hand.  NOT stsplit: stsplit blanks
* the stset failure variable on every non-terminal episode, and rebuilding it
* afterwards is the same work with an extra way to get it wrong.  `fail' is 1
* only on the episode that ends at the subject's own exit.
capture program drop _fgtv_split
program define _fgtv_split
    version 16.0
    args c1 c2
    quietly expand 3
    quietly bysort id: gen byte iv = _n
    quietly gen double start = cond(iv == 1, 0, cond(iv == 2, `c1', `c2'))
    quietly gen double _hi   = cond(iv == 1, `c1', cond(iv == 2, `c2', .))
    quietly gen double stop  = cond(missing(_hi), t, min(t, _hi))
    quietly drop if start >= t
    quietly gen byte fail = (status == 1) & (stop == t)
    quietly stset stop, failure(fail == 1) id(id) time0(start)
end

**# T01 equivalence with stcrreg, tvc() texp(_t > c)
local ++test_count
capture noisily {
    _fgtv_data
    * finegray needs every event as an stset failure and splits them with
    * compete()/cause(); stcrreg marks only the cause and names the competing
    * value.  Both fit the same model from the two stsets.
    quietly stset t, failure(status == 1) id(id)
    quietly stcrreg x1 x2, compete(status == 2) tvc(x1) texp(_t > 0.7) nolog
    matrix _sb = e(b)
    local _sll = e(ll)

    quietly stset t, failure(anyev == 1) id(id)
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.7) nolog
    matrix _fb = e(b)
    local _fll = e(ll)

    * stcrreg parameterises the second interval as main + tvc; finegray reports
    * the two interval coefficients directly.  Same model, different stripe.
    * reldif(., .) is 0 in Stata, so a missing coefficient would SATISFY every
    * comparison below.  Refuse the missing case first.
    assert !missing(_fb[1,1], _sb[1,2])
    assert reldif(_fb[1,1], _sb[1,2]) < 1e-8
    assert !missing(_fb[1,2], _sb[1,1])
    assert reldif(_fb[1,2], _sb[1,1]) < 1e-8
    * stcrreg's interval-2 coefficient is main + tvc; form it once so the
    * missing guard covers exactly what the comparison consumes.
    local _sb2 = _sb[1,1] + _sb[1,3]
    assert !missing(_fb[1,3], `_sb2')
    assert reldif(_fb[1,3], `_sb2') < 1e-8
    * The log-likelihood is the sharper half of this test: a scan that
    * accumulated a correct-looking score from the wrong risk sets would still
    * land on a different maximum.
    assert !missing(`_fll', `_sll')
    assert reldif(`_fll', `_sll') < 1e-9
}
local _rc = _rc
_fgtv_result `_rc' "T01 tvc()/tsplit() reproduces stcrreg tvc()/texp() (J=2)"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T02 equivalence with a hand-split episode Cox fit (J=3)
local ++test_count
capture noisily {
    _fgtv_data_nc
    quietly finegray x2 x1, compete(status) cause(1) tvc(x1) tsplit(0.4 1.0) ///
        nolog norobust
    matrix _fb2 = e(b)
    local _fll2 = e(ll)

    _fgtv_data_nc
    _fgtv_split 0.4 1.0
    * ibn., not i.: every interval carries a real coefficient here because the
    * interaction columns do not sum to a constant.
    quietly stcox x2 ibn.iv#c.x1, breslow nolog
    matrix _cb2 = e(b)
    local _cll2 = e(ll)

    forvalues j = 1/4 {
        assert !missing(_fb2[1, `j'], _cb2[1, `j'])
        assert reldif(_fb2[1, `j'], _cb2[1, `j']) < 1e-7
    }
    assert !missing(`_fll2', `_cll2')
    assert reldif(`_fll2', `_cll2') < 1e-9
}
local _rc = _rc
_fgtv_result `_rc' "T02 three intervals reproduce a split-episode Cox fit"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T03 a fit WITHOUT tvc() has not moved
local ++test_count
capture noisily {
    * The four right-censoring scans are called unmodified when nint <= 1, so
    * the ordinary path must be bit-identical to the tree before tvc() existed.
    * These numbers were captured there, on this fixture, and are pinned rather
    * than recomputed: a regression that moved BOTH the fit and the expectation
    * would pass any self-referential check.
    _fgtv_data
    quietly finegray x1 x2, compete(status) cause(1) nolog basehaz
    assert !missing(_b[x1], _b[x2], e(ll))
    assert reldif(_b[x1], 0.491100467552706) < 1e-13
    assert reldif(_b[x2], -0.374645390653994) < 1e-13
    assert reldif(e(ll), -2000.095085986130016) < 1e-13
    matrix _bh0 = e(basehaz)
    assert !missing(_bh0[5, 2])
    assert reldif(_bh0[5, 2], 0.005650493446466) < 1e-12
}
local _rc = _rc
_fgtv_result `_rc' "T03 a fit without tvc() reproduces the pre-feature values"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T04 an event exactly ON a boundary belongs to the EARLIER interval
local ++test_count
capture noisily {
    _fgtv_data
    * Move one cause event onto the boundary exactly, so the convention is
    * decidable rather than a measure-zero coincidence.
    quietly replace t = 0.7 if _n == 1
    quietly replace status = 1 if _n == 1
    quietly replace anyev = 1 if _n == 1
    quietly count if t == 0.7 & status == 1
    assert !missing(r(N))
    assert r(N) >= 1

    quietly stset t, failure(anyev == 1) id(id)
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.7) nolog
    matrix _tb = e(b)

    quietly stset t, failure(status == 1) id(id)
    quietly stcrreg x1 x2, compete(status == 2) tvc(x1) texp(_t > 0.7) nolog
    matrix _tg = e(b)
    quietly stcrreg x1 x2, compete(status == 2) tvc(x1) texp(_t >= 0.7) nolog
    matrix _tge = e(b)

    * (cut_j-1, cut_j] means `_t > 0.7' selects interval 2, so the strict form
    * is the match and the weak form must NOT be.
    assert !missing(_tb[1,2], _tg[1,1], _tge[1,1])
    assert reldif(_tb[1,2], _tg[1,1]) < 1e-8
    assert reldif(_tb[1,2], _tge[1,1]) > 1e-10
}
local _rc = _rc
_fgtv_result `_rc' "T04 an event on a boundary falls in the earlier interval"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T05 the coefficient stripe is the documented one and supports test
local ++test_count
capture noisily {
    _fgtv_data
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.4 1.0) nolog
    assert colsof(e(b)) == 4
    local _cn : colnames e(b)
    local _ce : coleq e(b)
    assert "`_cn'" == "x2 x1 x1 x1"
    assert "`_ce'" == "main tvc1 tvc2 tvc3"
    * The Wald test of "is this effect constant?" is the reason the intervals
    * carry separate coefficients rather than base-plus-offsets, and the reason
    * the equation names are plain: [5 < _t <= 10] would not parse.
    quietly test [tvc1]x1 = [tvc2]x1
    assert r(df) == 1
    quietly test [tvc1]x1 = [tvc2]x1 = [tvc3]x1
    assert r(df) == 2
}
local _rc = _rc
_fgtv_result `_rc' "T05 coefficient stripe is main/tvc1..tvcJ and test() works"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T06 the e() contract
local ++test_count
capture noisily {
    _fgtv_data
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.4 1.0) nolog
    assert e(n_intervals) == 3
    assert e(k_tvc) == 1
    assert "`e(tvc)'" == "x1"
    assert "`e(tsplit)'" == ".4 1"
    assert "`e(tvc_covariates)'" == "x1"
    assert "`e(tvc_pos)'" == "1"
    assert "`e(designvars)'" == "x1 x2"
    * Cause events per interval, posted so the reader can see what each
    * interval's estimate rests on.
    local _nf "`e(tsplit_nfail)'"
    assert `: word count `_nf'' == 3
    local _tot = 0
    foreach _n of local _nf {
        local _tot = `_tot' + `_n'
    }
    assert `_tot' == e(N_fail)
    * margins is withdrawn: there is no single linear predictor to average.
    assert "`e(marginsok)'" == ""
    * An ordinary fit reports the degenerate shape rather than nothing, so a
    * consumer never has to test for emptiness.
    quietly finegray x1 x2, compete(status) cause(1) nolog
    assert e(n_intervals) == 1
    assert "`e(tvc)'" == ""
}
local _rc = _rc
_fgtv_result `_rc' "T06 e() reports the piecewise shape and the mapping"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T07 e(refitcmd) reproduces e(b) exactly (the Z24 contract)
local ++test_count
capture noisily {
    _fgtv_data
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.4 1.0) nolog
    matrix _rb = e(b)
    local _rcmd `"`e(refitcmd)'"'
    * Named, because a dropped fit option does not error in the bootstrap: the
    * refit converges, its covariates still match, the replication is accepted,
    * and the band then describes a DIFFERENT estimator than the point estimate.
    assert strpos(`"`_rcmd'"', "tvc(x1)") > 0
    assert strpos(`"`_rcmd'"', "tsplit(.4 1)") > 0
    quietly `_rcmd'
    matrix _rb2 = e(b)
    mata: st_numscalar("_rdiff", max(abs(st_matrix("_rb") - st_matrix("_rb2"))))
    assert _rdiff == 0
}
local _rc = _rc
_fgtv_result `_rc' "T07 e(refitcmd) replays tvc()/tsplit() and reproduces e(b)"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T08 determinism
local ++test_count
capture noisily {
    _fgtv_data
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.4 1.0) nolog
    matrix _d1 = e(b)
    matrix _dv1 = e(V)
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.4 1.0) nolog
    matrix _d2 = e(b)
    matrix _dv2 = e(V)
    * Each interval re-sorts and re-scans, so the deterministic row-index tie
    * break has to survive being run J times.
    mata: st_numscalar("_dd", max(abs(st_matrix("_d1") - st_matrix("_d2"))))
    mata: st_numscalar("_dvv", max(abs(st_matrix("_dv1") - st_matrix("_dv2"))))
    assert _dd == 0
    assert _dvv == 0
}
local _rc = _rc
_fgtv_result `_rc' "T08 repeated piecewise fits are bit-identical"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T09 predict cif equals a hand-computed piecewise accumulation
local ++test_count
capture noisily {
    _fgtv_data
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.4 1.0) ///
        nolog basehaz
    quietly finegray_predict double _cifp, cif
    matrix _bh = e(basehaz)
    matrix _cb = e(b)

    * Rebuild CIF(t|z) from the posted baseline and the posted coefficients,
    * with no package code in the path except the step search.  That exception
    * is why this is a CONSISTENCY check on how the pieces are assembled and not
    * an independent one: _finegray_step_core carries the (cut_j-1, cut_j] tie
    * convention, so a build that flipped it moves BOTH sides of the comparison
    * and T09 still passes (verified 2026-08-25 by mutating the convention --
    * T09 green, T04 and the crossval TIES arms red).  T04 is the guard for the
    * convention; this test is the guard for the accumulation.  Formula:
    *   Lambda(t) = sum_j max(0, min(H0(t), H0(cut_j)) - H0(cut_{j-1})) exp(eta_j)
    * H0 is read at the largest event time <= t, which is the same convention
    * (cut_j-1, cut_j] implies.
    tempvar h0 ref
    quietly gen double `h0' = .
    quietly gen double `ref' = .
    mata {
        bh = st_matrix("_bh")
        cb = st_matrix("_cb")
        cuts = (0.4 \ 1.0)
        tt = st_data(., "_t")
        x1v = st_data(., "x1")
        x2v = st_data(., "x2")
        H0 = _finegray_step_core(bh, tt)
        Hc = _finegray_step_core(bh, cuts)
        eta = J(rows(tt), 3, 0)
        for (j = 1; j <= 3; j++) eta[., j] = cb[1,1] :* x2v :+ cb[1, j+1] :* x1v
        lam = J(rows(tt), 1, 0)
        lo = 0
        for (j = 1; j <= 3; j++) {
            hi = (j == 3 ? H0 : (H0 :< Hc[j]) :* H0 :+ (H0 :>= Hc[j]) :* Hc[j])
            piece = (hi :> lo) :* (hi :- lo)
            lam = lam + piece :* exp(eta[., j])
            if (j < 3) lo = Hc[j]
        }
        st_store(., st_varindex(st_local("ref")), 1 :- exp(-lam))
    }
    quietly count if abs(_cifp - `ref') > 1e-12 & _cifp < .
    assert r(N) == 0
    * and it is not trivially the proportional answer
    quietly summarize _cifp
    assert !missing(r(N), r(max))
    assert r(N) > 0 & r(max) > 0 & r(max) < 1
}
local _rc = _rc
_fgtv_result `_rc' "T09 predict cif matches a hand-built piecewise accumulation"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T10 predict xb is time-dependent, and attime() overrides the time
local ++test_count
capture noisily {
    _fgtv_data
    quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.7) nolog
    matrix _xb = e(b)
    quietly finegray_predict double _xbown, xb
    quietly finegray_predict double _xbe, xb attime(0.2)
    quietly finegray_predict double _xbl, xb attime(3)

    tempvar want
    quietly gen double `want' = _xb[1,1] * x2 + ///
        cond(_t <= 0.7, _xb[1,2], _xb[1,3]) * x1
    quietly count if abs(_xbown - `want') > 1e-12
    assert r(N) == 0
    * A constant evaluation time puts every row in one interval.
    quietly count if abs(_xbe - (_xb[1,1] * x2 + _xb[1,2] * x1)) > 1e-12
    assert r(N) == 0
    quietly count if abs(_xbl - (_xb[1,1] * x2 + _xb[1,3] * x1)) > 1e-12
    assert r(N) == 0
    * attime() exactly on the boundary is the earlier interval, as everywhere
    quietly drop _xbe
    quietly finegray_predict double _xbe, xb attime(0.7)
    quietly count if abs(_xbe - (_xb[1,1] * x2 + _xb[1,2] * x1)) > 1e-12
    assert r(N) == 0
}
local _rc = _rc
_fgtv_result `_rc' "T10 predict xb is interval-aware and attime() overrides it"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T11 factor variables: tvc() frees every column the variable enters
local ++test_count
capture noisily {
    _fgtv_data
    quietly finegray i.grp x1, compete(status) cause(1) tvc(grp) tsplit(0.7) nolog
    * i.grp is two design columns; naming the VARIABLE frees both together.
    assert e(k_tvc) == 2
    assert colsof(e(b)) == 5
    assert "`e(tvc_pos)'" == "1 2"
    local _ce : coleq e(b)
    assert "`_ce'" == "main tvc1 tvc1 tvc2 tvc2"
    * and the design columns behind it are named, so the mapping is checkable
    assert "`e(tvc_covariates)'" == "_fg_grp_2 _fg_grp_3"
    * post-estimation survives the factor rebuild path
    quietly finegray_predict double _fvxb, xb
    quietly finegray_predict double _fvcif, cif
    quietly summarize _fvcif
    assert !missing(r(N), r(max))
    assert r(N) > 0 & r(max) < 1
}
local _rc = _rc
_fgtv_result `_rc' "T11 tvc() on a factor variable frees all of its levels"
local pass_count = `pass_count' + r(pass)
local fail_count = `fail_count' + r(fail)

**# T12 the cost SHAPE, not the wall clock
local ++test_count
capture noisily {
    * An absolute time gate below ~2x is unfixable on a shared machine, so what
    * is asserted here is the RATIO's stability across n: each interval is one
    * more pass of a linear scan, so tvc/plain must not grow with n.  A rebuild
    * that walked the risk set quadratically inside a boundary would show up as
    * a rising ratio long before it showed up as a failing second count.
    local _rsmall = .
    local _rbig = .
    foreach _n in 4000 16000 {
        _fgtv_data 5150 `_n'
        quietly finegray x1 x2, compete(status) cause(1) nolog
        timer clear 91
        timer on 91
        quietly finegray x1 x2, compete(status) cause(1) nolog
        timer off 91
        quietly timer list 91
        local _tp = r(t91)
        timer clear 92
        timer on 92
        quietly finegray x1 x2, compete(status) cause(1) tvc(x1) tsplit(0.3 0.7 1.4) nolog
        timer off 92
        quietly timer list 92
        local _tt = r(t92)
        local _ratio = `_tt' / `_tp'
        display as text "  n=`_n' plain=`_tp' tvc(J=4)=`_tt' ratio=`_ratio'"
        if `_rsmall' >= . local _rsmall = `_ratio'
        else              local _rbig = `_ratio'
    }
    * Four intervals cost about four passes.  The band is wide because these are
    * seconds on a shared machine; what it forbids is the ratio DOUBLING over a
    * fourfold n, which is what a superlinear rebuild would do.
    assert `_rsmall' > 1 & `_rsmall' < 8
    assert `_rbig' > 1 & `_rbig' < 8
