*! crossval_binary_balance_cobalt.do Version 1.0.0  2026/11/17
*! Real-data parity of psdash balance (binary + continuous, raw and weighted) with R cobalt
*! Author: Timothy P Copeland, Karolinska Institutet
* Usage: cd psdash/qa && stata-mp -b do crossval_binary_balance_cobalt.do
*
* Data: the Dehejia-Wahba NSW trainees with the experimental controls (445) and
* with the 15,992 CPS controls (16,177), not distributed with the repository
* (CC BY-NC 2.0 third-party data, not MIT; attribution in
* data/binary_balance/SOURCE.md). Found by _psdash_qa_extdata.do: $STATA_QA_DATA
* copy, else a public download; exits 77 when neither is possible.
* Covariates are Imbens (2015) Tables 10 and 16: black hispanic age married
* nodegree education e74 u74 e75 u75 (six binary, four continuous).
* Weights: a logit propensity model on the ten covariates fitted in Stata;
* the weights are written to csv and handed to BOTH psdash and cobalt, so the
* comparison isolates the balance statistics.
*   cpsatt  CPS sample, ATT weights (treated 1, control ps/(1-ps))
*   cpsate  CPS sample, ATE weights (1/ps, 1/(1-ps)); very uneven weights
*   nswate  experimental sample, ATE weights
* Reference: cobalt::bal.tab(treat ~ ., weights = wt, s.d.denom = "pooled",
* binary = "std", continuous = "std", disp.means/v.ratio/ks), regenerated by
* every run through qa/_binary_balance_reference_psdash.R.
* Mapping (psdash r(balance) column : cobalt column):
*   1 Mean_T : M.1.Un   2 Mean_C : M.0.Un   3 SMD_Raw : Diff.Un
*   4 VR_Raw : V.Ratio.Un (continuous covariates only)   5 KS_Raw : KS.Un
*   6 Mean_T_adj : M.1.Adj   7 Mean_C_adj : M.0.Adj   8 SMD_Adj : Diff.Adj
*   9 VR_Adj : V.Ratio.Adj (continuous only)   10 KS_Adj : KS.Adj
* VR is compared for continuous covariates only: cobalt reports none for
* two-level covariates and psdash excludes them from its VR count (the VR of a
* two-level covariate is a function of its SMD inputs).
* KS for a two-level covariate is the difference in (weighted) proportions in
* both implementations.
* Exits 77 (RESULT skipped=dependency_unavailable) only when the data, Rscript
* or cobalt is genuinely unavailable.

clear all
version 16.0
set more off
set varabbrev off

capture log close _all
log using "crossval_binary_balance_cobalt.log", replace nomsg

do "`c(pwd)'/_psdash_bootstrap.do"
discard

run "`qa_dir'/_psdash_qa_extdata.do"
capture noisily {
    _psdash_qa_extfile binary_balance nsw_dw.dta, len(28598) crc(2283301062) ///
        url("https://users.nber.org/~rdehejia/data/nsw_dw.dta")
    global PSDASH_BBC_NSW `"`r(path)'"'
    global PSDASH_BBC_NSWSRC "`r(source)'"
    _psdash_qa_extfile binary_balance cps_controls.dta, len(705546) crc(2178836444) ///
        url("https://users.nber.org/~rdehejia/data/cps_controls.dta")
    global PSDASH_BBC_CPS `"`r(path)'"'
    global PSDASH_BBC_CPSSRC "`r(source)'"
}
if _rc {
    display as error "FAIL: NSW/CPS integrity check (rc=`=_rc')"
    display as text "RESULT: crossval_binary_balance_cobalt tests=1 pass=0 fail=1 skip=0"
    _psdash_qa_cleanup
    macro drop PSDASH_BBC_NSW PSDASH_BBC_CPS PSDASH_BBC_NSWSRC PSDASH_BBC_CPSSRC
    capture log close _all
    exit 9
}
if `"$PSDASH_BBC_NSW"' == "" | `"$PSDASH_BBC_CPS"' == "" {
    display as text "SKIP: NSW/CPS data unavailable (no STATA_QA_DATA copy and the public download failed)"
    display as text "RESULT: crossval_binary_balance_cobalt tests=0 pass=0 fail=0 skip=1 skipped=dependency_unavailable"
    _psdash_qa_cleanup
    macro drop PSDASH_BBC_NSW PSDASH_BBC_CPS PSDASH_BBC_NSWSRC PSDASH_BBC_CPSSRC
    capture log close _all
    exit 77
}
display as text "nsw_dw.dta source: $PSDASH_BBC_NSWSRC; cps_controls.dta source: $PSDASH_BBC_CPSSRC (length and CRC verified)"

global PSDASH_BBC_TESTS = 0
global PSDASH_BBC_PASS = 0
global PSDASH_BBC_FAIL = 0
global PSDASH_BBC_FAILED ""
global PSDASH_BBC_MAXD = 0

capture program drop _bbc_record
program define _bbc_record
    args id rc
    global PSDASH_BBC_TESTS = $PSDASH_BBC_TESTS + 1
    if `rc' == 0 {
        display as result "PASS: `id'"
        global PSDASH_BBC_PASS = $PSDASH_BBC_PASS + 1
    }
    else {
        display as error "FAIL: `id' (rc=`rc')"
        global PSDASH_BBC_FAIL = $PSDASH_BBC_FAIL + 1
        global PSDASH_BBC_FAILED "$PSDASH_BBC_FAILED `id'"
    }
end

* Build one spec: sample, covariates (Imbens definitions), logit PS, weight wt.
capture program drop _bbc_build
program define _bbc_build
    args spec
    if inlist("`spec'", "cpsatt", "cpsate") {
        tempfile trainees
        quietly use `"$PSDASH_BBC_NSW"', clear
        quietly keep if treat == 1
        quietly save `trainees'
        quietly use `"$PSDASH_BBC_CPS"', clear
        quietly append using `trainees'
    }
    else {
        quietly use `"$PSDASH_BBC_NSW"', clear
    }
    quietly generate byte u74 = (re74 == 0)
    quietly generate byte u75 = (re75 == 0)
    quietly generate double e74 = re74 / 1000
    quietly generate double e75 = re75 / 1000
    quietly logit treat black hispanic age married nodegree education ///
        e74 u74 e75 u75
    quietly predict double ps, pr
    if "`spec'" == "cpsatt" {
        quietly generate double wt = cond(treat == 1, 1, ps / (1 - ps))
    }
    else {
        quietly generate double wt = cond(treat == 1, 1 / ps, 1 / (1 - ps))
    }
    quietly assert !missing(wt) & wt > 0
end

* Look a reference value up by key (exactly one row) into scalar _bbc_val.
capture program drop _bbc_get
program define _bbc_get
    args key
    quietly frame ref: count if metric == "`key'"
    assert r(N) == 1
    quietly frame ref: summarize value if metric == "`key'", meanonly
    scalar _bbc_val = r(mean)
end

* Compare a psdash value (matrix element passed as text) with a reference key.
capture program drop _bbc_cmp
program define _bbc_cmp
    args psval key tol
    _bbc_get `key'
    local refval = scalar(_bbc_val)
    assert !missing(`psval') & !missing(`refval')
    local d = abs(`psval' - `refval')
    assert `d' < `tol'
    if `d' > $PSDASH_BBC_MAXD global PSDASH_BBC_MAXD = `d'
end

* All ten rows and all comparable columns of one spec.
capture program drop _bbc_spec
program define _bbc_spec
    args spec
    local covs "black hispanic age married nodegree education e74 u74 e75 u75"
    local cont " age education e74 e75 "
    _bbc_build `spec'
    quietly psdash balance treat, covariates(`covs') wvar(wt)
    matrix _bbcB = r(balance)
    assert rowsof(_bbcB) == 10 & colsof(_bbcB) == 10
    local tol 1e-10
    forvalues i = 1/10 {
        local v : word `i' of `covs'
        local rn : word `i' of `: rownames _bbcB'
        assert "`rn'" == "`v'"
        _bbc_cmp `=_bbcB[`i',1]'  `spec'_`v'_mt_raw  `tol'
        _bbc_cmp `=_bbcB[`i',2]'  `spec'_`v'_mc_raw  `tol'
        _bbc_cmp `=_bbcB[`i',3]'  `spec'_`v'_smd_raw `tol'
        _bbc_cmp `=_bbcB[`i',5]'  `spec'_`v'_ks_raw  `tol'
        _bbc_cmp `=_bbcB[`i',6]'  `spec'_`v'_mt_adj  `tol'
        _bbc_cmp `=_bbcB[`i',7]'  `spec'_`v'_mc_adj  `tol'
        _bbc_cmp `=_bbcB[`i',8]'  `spec'_`v'_smd_adj `tol'
        _bbc_cmp `=_bbcB[`i',10]' `spec'_`v'_ks_adj  `tol'
        if strpos("`cont'", " `v' ") {
            _bbc_cmp `=_bbcB[`i',4]' `spec'_`v'_vr_raw `tol'
            _bbc_cmp `=_bbcB[`i',9]' `spec'_`v'_vr_adj `tol'
        }
        else {
            * the two-level rows must really be two-level (no VR reference)
            quietly tabulate `v'
            assert r(r) == 2
        }
    }
end

tempfile r_dep_ok r_run_ok ref_dta pub_marker
local refdir "`pub_marker'_bb_ref"
capture mkdir "`refdir'"

capture erase "`r_dep_ok'"
shell Rscript -e "quit(status=ifelse(requireNamespace('cobalt', quietly=TRUE), 0, 1))" > /dev/null 2>&1 && touch "`r_dep_ok'"
capture confirm file "`r_dep_ok'"
if _rc {
    display as text "SKIP (dependency): Rscript or R package cobalt unavailable"
    display as text "RESULT: crossval_binary_balance_cobalt tests=0 pass=0 fail=0 skip=0 skipped=dependency_unavailable"
    _psdash_qa_cleanup
    capture shell rm -rf "`refdir'"
    macro drop PSDASH_BBC_TESTS PSDASH_BBC_PASS PSDASH_BBC_FAIL PSDASH_BBC_FAILED PSDASH_BBC_MAXD PSDASH_BBC_NSW PSDASH_BBC_CPS PSDASH_BBC_NSWSRC PSDASH_BBC_CPSSRC
    capture log close _all
    exit 77
}

**# Reference generation
**## cobalt computes balance on the weights psdash is given

capture noisily {
    foreach spec in cpsatt cpsate nswate {
        _bbc_build `spec'
        export delimited treat black hispanic age married nodegree education ///
            e74 u74 e75 u75 wt using "`refdir'/`spec'.csv", replace
    }
    capture erase "`r_run_ok'"
    shell Rscript "`qa_dir'/_binary_balance_reference_psdash.R" "`refdir'/ref.csv" ///
        cpsatt "`refdir'/cpsatt.csv" cpsate "`refdir'/cpsate.csv" ///
        nswate "`refdir'/nswate.csv" && touch "`r_run_ok'"
    confirm file "`r_run_ok'"
    confirm file "`refdir'/ref.csv"
    capture frame drop ref
    frame create ref
    frame ref {
        import delimited using "`refdir'/ref.csv", varnames(1) asdouble ///
            stringcols(1) clear
        * 3 specs x (10 covariates x 8 metrics + 4 continuous x 2 VR)
        assert _N == 3 * (10 * 8 + 4 * 2)
        assert !missing(value)
    }
}
local setup_rc = _rc
_bbc_record cobalt_reference_generated `setup_rc'
if `setup_rc' {
    display as text "RESULT: crossval_binary_balance_cobalt tests=$PSDASH_BBC_TESTS pass=$PSDASH_BBC_PASS fail=$PSDASH_BBC_FAIL skip=0"
    _psdash_qa_cleanup
    capture shell rm -rf "`refdir'"
    macro drop PSDASH_BBC_TESTS PSDASH_BBC_PASS PSDASH_BBC_FAIL PSDASH_BBC_FAILED PSDASH_BBC_MAXD PSDASH_BBC_NSW PSDASH_BBC_CPS PSDASH_BBC_NSWSRC PSDASH_BBC_CPSSRC
    capture log close _all
    exit 9
}

**# Parity
**## CPS controls vs trainees, ATT weights

capture noisily {
    _bbc_spec cpsatt
}
_bbc_record cps_att_matches_cobalt `=_rc'

**## CPS controls vs trainees, ATE weights

capture noisily {
    _bbc_spec cpsate
}
_bbc_record cps_ate_matches_cobalt `=_rc'

**## Experimental controls vs trainees, ATE weights

capture noisily {
    _bbc_spec nswate
}
_bbc_record nsw_ate_matches_cobalt `=_rc'

**## The weights actually move the adjusted columns

capture noisily {
    _bbc_build cpsatt
    quietly psdash balance treat, ///
        covariates(black hispanic age married nodegree education e74 u74 e75 u75) ///
        wvar(wt)
    assert !missing(r(max_smd_raw)) & !missing(r(max_smd_adj))
    assert r(max_smd_adj) < 0.5 * r(max_smd_raw)
    matrix _bbcB = r(balance)
    * adjusted Mean_C of Black equals the treated mean once weighted (ATT)
    assert !missing(_bbcB[1,6]) & !missing(_bbcB[1,7])
    assert abs(_bbcB[1,6] - _bbcB[1,7]) < 0.01
}
_bbc_record att_weights_balance_the_sample `=_rc'

capture frame drop ref
capture matrix drop _bbcB
display as text "max |psdash - cobalt| over all compared cells: " %10.3e $PSDASH_BBC_MAXD
display as text _n "RESULT: crossval_binary_balance_cobalt tests=$PSDASH_BBC_TESTS pass=$PSDASH_BBC_PASS fail=$PSDASH_BBC_FAIL skip=0"

local final_fail = $PSDASH_BBC_FAIL
local failed "$PSDASH_BBC_FAILED"
macro drop PSDASH_BBC_TESTS PSDASH_BBC_PASS PSDASH_BBC_FAIL PSDASH_BBC_FAILED PSDASH_BBC_MAXD PSDASH_BBC_NSW PSDASH_BBC_CPS PSDASH_BBC_NSWSRC PSDASH_BBC_CPSSRC
capture shell rm -rf "`refdir'"
_psdash_qa_cleanup
capture log close _all

if `final_fail' {
    display as error "Failed tests:`failed'"
    exit 9
}
